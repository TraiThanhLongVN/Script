-- Ẩn/Hiện Menu
toggleBtn.MouseButton1Click:Connect(function()
	mainFrame.Visible = not mainFrame.Visible
end)

-- Bật/Tắt chế độ chọn khối
selectModeBtn.MouseButton1Click:Connect(function()
	isSelectMode = not isSelectMode
	if isSelectMode then
		selectModeBtn.Text = "SELECT: ON"
		selectModeBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
	else
		selectModeBtn.Text = "SELECT: OFF"
		selectModeBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
		highlight.Parent = nil
		selectedBlock = nil
	end
end)

-- Chọn khối trong Workspace
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or not isSelectMode then return end
	
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local unitRay = camera:ScreenPointToRay(input.Position.X, input.Position.Y)
		local raycastResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 500)

		if raycastResult and raycastResult.Instance then
			local model = raycastResult.Instance:FindFirstAncestorOfClass("Model")
			if model and model.Parent and model.Parent.Name == "BuildModel" then
				selectedBlock = model
				highlight.Parent = selectedBlock
			end
		end
	end
end)

-- Gửi lệnh cho Server
actionBtn.MouseButton1Click:Connect(function()
	if not selectedBlock then 
		print("Lỗi: Chưa chọn khối!")
		return 
	end

	local x = tonumber(inputX.Text) or 1
	local y = tonumber(inputY.Text) or 1
	local z = tonumber(inputZ.Text) or 1
	
	local colorPart = selectedBlock:FindFirstChild("ColorPart") or selectedBlock:FindFirstChildWhichIsA("BasePart")

	if colorPart then
		local args = {
			selectedBlock,
			{
				colorPart,
				colorPart.CFrame,
				Vector3.new(x, y, z)
			}
		}
		
		local success, err = pcall(function()
			ReplicatedStorage.Functions.CommitResize:InvokeServer(unpack(args))
		end)
		
		if success then
			print("Thành công!")
		else
			warn("Lỗi Server: " .. tostring(err))
		end
	end
end)
